{
  "name": "frontend",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "sync:timezone-fixtures": "bun run scripts/sync-timezone-fixtures.ts",
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "check": "run-s lint:check type-check build-only",
    "check:eslint-baseline": "bun run scripts/check-eslint-baseline.ts",
    "generate:eslint-baseline": "bun run scripts/check-eslint-baseline.ts --update",
    "lint": "bun run lint:fix",
    "lint:check": "bun run check:eslint-baseline",
    "lint:fix": "eslint . --fix --cache",
    "format": "prettier --write src/ scripts/ docs/ AGENTS.md",
    "format:check": "prettier --check src/ scripts/ docs/ AGENTS.md",
    "release": "bun run scripts/release.ts"
  },
  "dependencies": {
    "@lucide/vue": "^1.55.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "heatmap.js": "^2.0.5",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node22": "^22.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "~10.11.1",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "3.9.9",
    "prettier-plugin-vue": "^1.1.6",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.12"
  }
}
